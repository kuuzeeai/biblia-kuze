<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true">

    <!-- Texto de la Biblia (ocupa toda la pantalla, el contenido se mueve bajo las barras) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_lectura"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/texto_biblia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="90dp"
            android:paddingBottom="220dp"
            android:textColor="@color/texto"
            android:textSize="18sp" />

    </androidx.core.widget.NestedScrollView>

    <!-- Barra superior: título, tamaño de letra, estrella y menú -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/cajon_redondeado"
        android:layout_margin="12dp"
        android:elevation="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/titulo_lectura"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boton_menos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/capsula"
            android:contentDescription="Letra más pequeña"
            android:gravity="center"
            android:text="A−"
            android:textColor="@color/primario"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boton_mas"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/capsula"
            android:contentDescription="Letra más grande"
            android:gravity="center"
            android:text="A+"
            android:textColor="@color/primario"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/boton_estrella"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_estrella"
            android:tint="@color/primario"
            android:contentDescription="Guardar este capítulo" />

        <ImageView
            android:id="@+id/boton_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            android:tint="@color/primario"
            android:contentDescription="Menú" />

    </LinearLayout>

    <!-- Barra inferior: botones grandes con texto y pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hoja_inferior"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fab_izquierda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Capítulo anterior"
                android:gravity="center"
                android:minHeight="76dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circulo_vidrio"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_flecha_izq"
                    android:tint="@color/sobre_primario" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Anterior"
                    android:textColor="@color/primario"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fab_audio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Leer en voz alta"
                android:gravity="center"
                android:minHeight="76dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icono_audio"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circulo_vidrio"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_audio"
                    android:tint="@color/sobre_primario" />

                <TextView
                    android:id="@+id/texto_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Escuchar"
                    android:textColor="@color/primario"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fab_derecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Siguiente capítulo"
                android:gravity="center"
                android:minHeight="76dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circulo_vidrio"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_flecha_der"
                    android:tint="@color/sobre_primario" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Siguiente"
                    android:textColor="@color/primario"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/borde" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_leer"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/capsula"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_libro"
                    android:tint="@color/primario" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leer"
                    android:textColor="@color/primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_ir"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lista"
                    android:tint="@color/primario" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ir a…"
                    android:textColor="@color/primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_buscar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lupa"
                    android:tint="@color/primario" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscar"
                    android:textColor="@color/primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_marcadores"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_marcador"
                    android:tint="@color/primario" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marcadores"
                    android:textColor="@color/primario"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Navegador de pantalla completa: Libros -> Capítulos -> Versículos -->
    <LinearLayout
        android:id="@+id/navegador"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/superficie"
            android:elevation="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/nav_atras"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_flecha_izq"
                android:tint="@color/primario"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/nav_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/nav_libros"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:divider="@null"
                android:dividerHeight="2dp" />

            <GridView
                android:id="@+id/nav_capitulos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:padding="8dp"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:stretchMode="columnWidth"
                android:gravity="center"
                android:visibility="gone" />

            <GridView
                android:id="@+id/nav_versiculos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:padding="8dp"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:stretchMode="columnWidth"
                android:gravity="center"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
