<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/hoja_dialogo"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="VERSÍCULO DEL DÍA"
            android:textColor="@color/texto_sec"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dia_referencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/primario"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/borde" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/dia_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/texto"
                android:textSize="20sp" />
        </ScrollView>

        <TextView
            android:id="@+id/boton_dia_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/cajon_activo"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/sobre_primario"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boton_dia_leer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/capsula"
                android:gravity="center"
                android:padding="13dp"
                android:text="Leer capítulo"
                android:textColor="@color/primario"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/boton_dia_cerrar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/capsula"
                android:gravity="center"
                android:padding="13dp"
                android:text="Cerrar"
                android:textColor="@color/primario"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
