<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/capsula"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/icono_voz"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circulo_icono"
        android:gravity="center"
        android:textColor="@color/primario"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombre_voz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detalle_voz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_sec"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/marca_voz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:text="✓"
        android:textColor="@color/sobre_primario"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
